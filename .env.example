PRINTIFY_TOKEN=your_printify_personal_access_token
# Optional — auto-detected from your account if omitted
PRINTIFY_SHOP_ID=
# Only Printify products with this tag appear on the site (default: site-live)
LIVE_PRODUCT_TAG=site-live
# Comma-separated Printify product IDs to always hide (mug + blanket by default)
# Set to empty to disable: HIDDEN_PRODUCT_IDS=

# Stripe Checkout (test keys for local dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
SITE_URL=http://localhost:8080

# Manual order notifications (Resend)
RESEND_API_KEY=re_...
NOTIFY_EMAIL=you@example.com
RESEND_FROM_EMAIL=orders@dantefuego.com

# Cloudflare Pages (set as encrypted secrets in the dashboard, not here):
# wrangler pages secret put PRINTIFY_TOKEN --project-name=dantefuegodev
# wrangler pages secret put STRIPE_SECRET_KEY --project-name=dantefuegodev
# wrangler pages secret put STRIPE_WEBHOOK_SECRET --project-name=dantefuegodev
# wrangler pages secret put RESEND_API_KEY --project-name=dantefuegodev
