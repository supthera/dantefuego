PRINTIFY_TOKEN=your_printify_personal_access_token
# Optional — auto-detected from your account if omitted
PRINTIFY_SHOP_ID=
# Only Printify products with this tag appear on the site (default: site-live)
LIVE_PRODUCT_TAG=site-live

# Cloudflare Pages (set as encrypted secrets in the dashboard, not here):
# wrangler pages secret put PRINTIFY_TOKEN --project-name=dantefuego
